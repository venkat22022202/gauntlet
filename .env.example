# ============================================================
# GAUNTLET — environment
# ============================================================
# The core scan demo needs NO backend. You paste a model API key
# into the UI at runtime and it is used only for that scan.
# The variables below are ONLY needed for the optional persistence
# layer (saved scans, the public leaderboard).
# ------------------------------------------------------------

# Optional — persistence (Neon Postgres)
DATABASE_URL=

# Optional — accounts (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional — rate limiting / queue (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — a server-side default key so visitors can try a demo
# scan WITHOUT pasting their own key. Leave blank to require BYO-key.
GAUNTLET_DEMO_OPENAI_KEY=

# Server-side Gemini key powering the "Load suggested injections" AI engine.
# Required for that button to work. Never exposed to the client.
GAUNTLET_SUGGEST_KEY=
GAUNTLET_SUGGEST_MODEL=gemini-3.5-flash
